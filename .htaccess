# Cadeaux Pare-Brise — configuration Apache

# ------------------------------------------------------------------
# HTTPS + www obligatoires (redirection 301, favorable au SEO)
# ------------------------------------------------------------------
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www (redirige cadeauxparebrise.fr -> www.cadeauxparebrise.fr)
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ------------------------------------------------------------------
# Page d'accueil et pages du site
# ------------------------------------------------------------------
DirectoryIndex index.html

# ------------------------------------------------------------------
# Compression (accélère le chargement)
# ------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------
# Cache navigateur
# Les fichiers CSS/JS sont versionnés (?v=hash), donc on peut les
# mettre en cache longtemps sans risque de servir une version périmée.
# ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ------------------------------------------------------------------
# Sécurité de base
# ------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes
